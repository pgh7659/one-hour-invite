# UI & Form Patterns — shadcn/ui + react-hook-form + zod

## 0. Goal
Establish consistent UI and form patterns:
- Use shadcn/ui components as the base UI library
- Integrate react-hook-form with zod for form validation
- Maintain Server-First principles with form submissions
- Ensure type-safe, accessible, and consistent UI

---

## 1. shadcn/ui Setup & Usage

### 1.1 Initial Setup
Install and configure shadcn/ui:

```bash
npx shadcn@latest init
```

Recommended settings:
- TypeScript: Yes
- Style: Default
- Base color: Slate
- CSS variables: Yes

### 1.2 Component Installation
Add components as needed:

```bash
npx shadcn@latest add button
npx shadcn@latest add form
npx shadcn@latest add input
npx shadcn@latest add select
npx shadcn@latest add dialog
npx shadcn@latest add toast
```

### 1.3 Component Customization
- Customize components in `src/components/ui/` after installation
- Use CSS variables for theming (defined in `globals.css`)
- Prefer composition over modification

---

## 2. Form Patterns with react-hook-form + zod

### 2.1 Schema Definition
Define Zod schemas in route's `types/` or `api/` folder:

```typescript
// src/app/mypage/api/schemas.ts
import { z } from "zod";

export const createInvitationSchema = z.object({
  title: z.string().min(1, "제목을 입력해주세요").max(100),
  description: z.string().optional(),
  eventDate: z.string().datetime(),
  maxGuests: z.number().int().positive().optional(),
});

export type CreateInvitationInput = z.infer<typeof createInvitationSchema>;
```

### 2.2 Server Action with Schema Validation
Use the same schema in Server Actions:

```typescript
// src/app/mypage/api/actions.server.ts
"use server";

import { createInvitationSchema } from "./schemas";
import { createInvitation } from "./mutations";

export async function createInvitationAction(
  input: unknown
): Promise<{ ok: true; data: Invitation } | { ok: false; error: { code: string; message: string; fieldErrors?: Record<string, string[]> } }> {
  const result = createInvitationSchema.safeParse(input);
  
  if (!result.success) {
    return {
      ok: false,
      error: {
        code: "VALIDATION_ERROR",
        message: "입력값이 올바르지 않습니다",
        fieldErrors: result.error.flatten().fieldErrors,
      },
    };
  }
  
  // ... mutation logic
}
```

### 2.3 Client Form Component
Create form components using react-hook-form:

```typescript
// src/app/mypage/components/create-invitation-form.tsx
"use client";

import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { createInvitationSchema, type CreateInvitationInput } from "../api/schemas";
import { createInvitationAction } from "../api/actions.server";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form";
import { useToast } from "@/hooks/use-toast";

export function CreateInvitationForm() {
  const { toast } = useToast();
  const form = useForm<CreateInvitationInput>({
    resolver: zodResolver(createInvitationSchema),
    defaultValues: {
      title: "",
      description: "",
      maxGuests: undefined,
    },
  });

  async function onSubmit(data: CreateInvitationInput) {
    const result = await createInvitationAction(data);
    
    if (!result.ok) {
      if (result.error.fieldErrors) {
        Object.entries(result.error.fieldErrors).forEach(([field, errors]) => {
          form.setError(field as keyof CreateInvitationInput, {
            message: errors?.[0] ?? result.error.message,
          });
        });
      } else {
        toast({
          variant: "destructive",
          title: "오류",
          description: result.error.message,
        });
      }
      return;
    }
    
    toast({
      title: "성공",
      description: "초대장이 생성되었습니다",
    });
    form.reset();
  }

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
        <FormField
          control={form.control}
          name="title"
          render={({ field }) => (
            <FormItem>
              <FormLabel>제목</FormLabel>
              <FormControl>
                <Input {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        {/* ... more fields ... */}
        <Button type="submit" disabled={form.formState.isSubmitting}>
          생성하기
        </Button>
      </form>
    </Form>
  );
}
```

