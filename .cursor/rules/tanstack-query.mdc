## 3. Prefetch + Dehydrate Pattern

### 3.1 Server-Side Prefetch
Prefetch data in Server Components or Route Handlers:

```typescript
// src/app/mypage/page.tsx
import { HydrationBoundary, dehydrate } from "@tanstack/react-query";
import { getQueryClient } from "@/lib/query-client";
import { prefetchInvitations } from "./api/prefetch";

export default async function MyPage() {
  const queryClient = getQueryClient();
  
  await prefetchInvitations(queryClient);
  
  return (
    <HydrationBoundary state={dehydrate(queryClient)}>
      <InvitationsList />
    </HydrationBoundary>
  );
}
```

### 3.2 Query Client Factory (Server-Safe)
Create `src/lib/query-client.ts`:

```typescript
import { QueryClient } from "@tanstack/react-query";
import { cache } from "react";

export const getQueryClient = cache(() => new QueryClient({
  defaultOptions: {
    queries: {
      staleTime: 60 * 1000,
    },
  },
}));
```

### 3.3 Prefetch Functions
Place prefetch logic in route's `api/` folder:

```typescript
// src/app/mypage/api/prefetch.ts
import { QueryClient } from "@tanstack/react-query";
import { getInvitations } from "./queries";

export async function prefetchInvitations(queryClient: QueryClient) {
  await queryClient.prefetchQuery({
    queryKey: ["invitations"],
    queryFn: getInvitations,
  });
}
```

---

## 4. Query Hooks Pattern

### 4.1 Query Functions
Define query functions in route's `api/queries.ts`:

```typescript
// src/app/mypage/api/queries.ts
import { createClient } from "@/lib/supabase/server";

export async function getInvitations() {
  const supabase = await createClient();
  const { data, error } = await supabase
    .from("invitations")
    .select("*")
    .order("created_at", { ascending: false });
  
  if (error) throw error;
  return data;
}
```

### 4.2 Custom Hooks
Create hooks in route's `hooks/` folder:

```typescript
// src/app/mypage/hooks/use-invitations.ts
"use client";

import { useQuery } from "@tanstack/react-query";
import { getInvitations } from "../api/queries";

export function useInvitations() {
  return useQuery({
    queryKey: ["invitations"],
    queryFn: getInvitations,
  });
}
```

