## 5. Mutations with TanStack Query

### 5.1 Invalidate After Server Actions
After Server Actions, invalidate queries:

```typescript
"use client";

import { useQueryClient } from "@tanstack/react-query";
import { createInvitation } from "./api/actions.server";

export function CreateInvitationForm() {
  const queryClient = useQueryClient();
  
  async function handleSubmit(formData: FormData) {
    const result = await createInvitation(formData);
    if (result.ok) {
      queryClient.invalidateQueries({ queryKey: ["invitations"] });
    }
  }
  
  return <form action={handleSubmit}>...</form>;
}
```

### 5.2 Optimistic Updates
For better UX, use optimistic updates:

```typescript
"use client";

import { useMutation, useQueryClient } from "@tanstack/react-query";
import { updateInvitation } from "./api/actions.server";

export function useUpdateInvitation() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: updateInvitation,
    onMutate: async (newData) => {
      await queryClient.cancelQueries({ queryKey: ["invitations"] });
      const previous = queryClient.getQueryData(["invitations"]);
      queryClient.setQueryData(["invitations"], (old) => 
        old.map((item) => item.id === newData.id ? { ...item, ...newData } : item)
      );
      return { previous };
    },
    onError: (err, newData, context) => {
      queryClient.setQueryData(["invitations"], context.previous);
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: ["invitations"] });
    },
  });
}
```

